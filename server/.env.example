# Sovereign Grid backend — environment template
# Copy to `.env` (which is gitignored) and fill in real values.
#
# Runtime role is sg_app (least privilege; RLS is the security boundary).
# `npm run migrate` forces the sg_migrate role internally, whatever this says.
#
# Postgres runs locally on the unix socket /tmp with trust auth (no password).
# citext extension must be pre-created by an admin on the target database.
DATABASE_URL=postgresql://sg_app@/<DATABASE>?host=/tmp
